app/app.bundle
app/addons/

# Vendored Bare Kit prebuild (run `make framework`)
app/frameworks/

# Generated Xcode project (run `xcodegen generate`)
*.xcodeproj
app/Info.plist

# Build output
.build/
build/
DerivedData/
